{
  "manifest_version": 3,
  "name": "Claude YH TMWD CDP Bridge",
  "version": "2.1.0",
  "description": "Connects Claude YH BrowserControl to the current Chrome session.",
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "debugger",
    "scripting",
    "alarms",
    "management"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude YH Browser Bridge"
  }
}
