{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ant/claude-for-chrome-mcp": [
        "./stubs/ant-claude-for-chrome-mcp.ts"
      ],
      "color-diff-napi": [
        "./stubs/color-diff-napi.ts"
      ],
      "src/*": [
        "./src/*"
      ]
    },
    "types": [
      "bun-types",
      "react",
      "react-dom",
      "vitest/globals"
    ]
  },
  "exclude": [
    "node_modules",
    "desktop/node_modules",
    "desktop/src-tauri/target",
    "desktop/dist",
    "dist"
  ]
}
